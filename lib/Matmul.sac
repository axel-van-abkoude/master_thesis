module Matmul;
use Util:all;
use ControlFlow: {touch};
export all;

noinline double[m,p] matmul_cuda(double[m,n] a, double[n,p] b) {
  touch();
  return with {
    (. <= [i,j] <= .) : sum({[k] -> a[i,k] * b[k,j]});
  } : genarray([m,p],0d);
}

noinline double[m,p] matmul_nocuda(double[m,n] a, double[n,p] b) {
  touch();
  return with {
    #pragma nocuda
    (. <= [i,j] <= .) : sum({[k] -> a[i,k] * b[k,j]});
  } : genarray([m,p],0d);
}
