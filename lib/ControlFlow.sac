#pragma safe
class ControlFlow;
external classtype;
export all;
objdef ControlFlow TheControlFlow = createControlFlow();
external ControlFlow createControlFlow();
    #pragma linkobj "src/control_flow.o"
    #pragma linksign [1]
external void touch(ControlFlow& obj);
    #pragma linkobj "src/control_flow.o"
void touch() { touch(TheControlFlow); }
