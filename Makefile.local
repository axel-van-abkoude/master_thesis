.PHONY: build-all build-sac2c build-lib \
  rebuild-all rebuild-sac2c rebuild-lib \
  clean-all clean-bin clean-build

TARGETS ?=cuda_mt

BUILD_DIR ?=$(LOCAL_ROOT)/build
BIN_DIR ?=$(LOCAL_ROOT)/bin
SAC2C_EXEC ?=$(BIN_DIR)/sac2c_d

build-all: ## Build all
	$(MAKE) build-sac2c && $(MAKE) build-lib

build-sac2c: ## Build sac2c
	cmake \
		-DCMAKE_BUILD_TYPE=DEBUG \
		-B $(BIN_DIR) -S sac2c
	$(MAKE) -C $(BIN_DIR)

build-lib: ## Build lib
	TARGETS=$(TARGETS) \
	BUILD_DIR=$(BUILD_DIR) \
	SAC2C_EXEC=$(SAC2C_EXEC) \
	$(MAKE) -C lib build

rebuild-all: ## Rebuild all
	$(MAKE) clean-all && $(MAKE) build-all
rebuild-sac2c: ## Rebuild sac2c
	$(MAKE) clean-bin && $(MAKE) build-sac2c
rebuild-lib: ## Rebuild lib
	$(MAKE) clean-build && $(MAKE) build-lib

clean-all:
	$(MAKE) clean-bin && $(MAKE) clean-build
clean-build:
	rm -rf $(BUILD_DIR)
clean-bin:
	rm -rf $(BIN_DIR)

