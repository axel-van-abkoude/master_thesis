THIS_FILE := $(realpath $(firstword $(MAKEFILE_LIST)))
R := $(dir $(THIS_FILE))
B := $Rbuild/
L := $Rlib/
SAC := $Rbin/sac2c_p
.PHONY: build clean-bin clean-build options

TARGET ?= seq ## Target used by build file

options:
	@echo "Options for: $(THIS_FILE)"
	@grep -E '^[A-Z_]+[[:space:]]*\?=.*##|^[a-zA-Z0-9_-]+:.*##' $(THIS_FILE)

bin: ## Building sac2c
	git submodule update --init --recursive
	cmake \
		-DCMAKE_BUILD_TYPE=RELEASE \
		-B $Rbin -S $Rsac2c
	$(MAKE) -C $Rbin

clean-bin: ## Cleans up bin folder
	ls -la $Rbin; rm -rI bin

build: ## Building lib for one target specified in TARGET
	mkdir -p $Bsrc
	$(CC) -c -o $Bsrc/control_flow.o $Lsrc/control_flow.c
	$(SAC) -t $(TARGET) -o $B $LControlFlow.sac
	$(SAC) -t $(TARGET) -o $B $LUtil.sac
	$(SAC) -t $(TARGET) -o $B $LInc.sac
	$(SAC) -t $(TARGET) -o $B $LMatmul.sac

clean-build: ## Cleans up build folder
	ls -la $Rbuild; rm -rI build
	
