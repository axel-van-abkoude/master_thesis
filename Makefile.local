.PHONY: sac2c lib clean-bin clean-build
TARGETS ?= $(TARGET)

BUILD_DIR ?= $(LOCAL_ROOT)/build/
BIN_DIR ?= $(LOCAL_ROOT)/bin/
SAC2C_EXEC ?= $(BIN_DIR)/sac2c_p

sac2c: ## Building sac2c
	git submodule update --init --recursive
	cmake \
		-DCMAKE_BUILD_TYPE=RELEASE \
		-B $(BIN_DIR) -S sac2c
	$(MAKE) -C $(BIN_DIR)

lib: ## Building lib
	#git submodule update --init --recursive
	TARGETS=$(TARGETS) \
	BUILD_DIR=$(BUILD_DIR) \
	SAC2C_EXEC=$(SAC2C_EXEC) \
  $(MAKE) -C lib build


clean-build:
	rm -rf $(BUILD_DIR)
clean-bin:
	rm -rf $(BIN_DIR)

